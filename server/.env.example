# Environment variables for the Node.js / Express backend

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Neon.tech PostgreSQL)
# Example: postgresql://[user]:[password]@[endpoint].neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://user:password@endpoint.neon.tech/neondb?sslmode=require"

# Authentication Secrets
# Use strong random strings for production
JWT_ACCESS_SECRET="super_secret_access_key_123"
JWT_REFRESH_SECRET="super_secret_refresh_key_456"

# Redis / BullMQ Configuration (Upstash)
# Upstash connection string MUST start with rediss:// for secure TLS connection
REDIS_URL="rediss://default:password@endpoint.upstash.io:6379"

# Google Gemini AI Integration
# Get an API key from https://aistudio.google.com/
GEMINI_API_KEY="your-gemini-api-key"

# Email Configuration (SendGrid/Nodemailer)
EMAIL_FROM="noreply@healthclinic.com"
# Example if using SendGrid SMTP:
# EMAIL_HOST="smtp.sendgrid.net"
# EMAIL_PORT=587
# EMAIL_USER="apikey"
# EMAIL_PASS="your-sendgrid-api-key"

# Google Calendar OAuth Integration (Optional but recommended)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:5000/api/v1/calendar/oauth/callback"
